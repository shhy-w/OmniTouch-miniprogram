<template>
  <view class="page">
    <view class="title">设置</view>
    <view class="panel">
      <view class="row">
        <view>
          <view class="key">⌬ MQTT Broker</view>
          <view class="desc">真实地址由后端提供，当前使用本地模拟传输</view>
        </view>
      </view>
      <input class="input" value="{{broker}}" bindinput="onBrokerInput" placeholder="your-mqtt-broker.com" placeholder-class="placeholder" />
      <view class="row split">
        <text>端口</text>
        <input class="port" type="number" value="{{port}}" bindinput="onPortInput" />
      </view>
      <button class="action" bindtap="save">保存配置</button>
    </view>

    <view class="panel">
      <view class="row split"><text>调试模式</text><switch checked="{{debug}}" bindchange="onDebugChange" color="#3B82F6" /></view>
      <view class="row split"><text>深色主题</text><switch checked disabled color="#3B82F6" /></view>
      <view class="row split"><text>☰ 离线队列</text><text>{{queueCount}} 条待补发</text></view>
    </view>

    <button class="danger" bindtap="clearCache">清理本地设备缓存</button>
  </view>
</template>

<script lang="ts">
import { createPage } from '@mpxjs/core'
import { deviceStore } from '@/stores/device'

const CONFIG_KEY = 'smartterm_mqtt_config'

createPage({
  data: {
    broker: 'your-mqtt-broker.com',
    port: '1883',
    debug: true,
    queueCount: 0
  },
  onShow() {
    const config = wx.getStorageSync(CONFIG_KEY) || {}
    this.setData({
      broker: config.broker || this.broker,
      port: config.port || this.port,
      debug: config.debug !== false,
      queueCount: deviceStore.offlineQueue.length
    })
  },
  methods: {
    onBrokerInput(event: { detail: { value: string } }) {
      this.setData({ broker: event.detail.value })
    },
    onPortInput(event: { detail: { value: string } }) {
      this.setData({ port: event.detail.value })
    },
    onDebugChange(event: { detail: { value: boolean } }) {
      this.setData({ debug: event.detail.value })
    },
    save() {
      wx.setStorageSync(CONFIG_KEY, {
        broker: this.broker,
        port: this.port,
        debug: this.debug
      })
      wx.showToast({ title: '配置已保存', icon: 'success' })
    },
    clearCache() {
      wx.showModal({
        title: '清理缓存',
        content: '会清空本地设备列表、事件日志和离线队列。',
        success: (res) => {
          if (res.confirm) {
            deviceStore.clearCache()
            this.setData({ queueCount: 0 })
            wx.showToast({ title: '已清理', icon: 'success' })
          }
        }
      })
    }
  }
})
</script>

<style>
.page {
  min-height: 100vh;
  padding: 48rpx 28rpx;
  background:
    radial-gradient(circle at 76% 0%, rgba(59, 130, 246, 0.2), transparent 36%),
    linear-gradient(180deg, #0f172a, #111827 52%, #08111f);
  box-sizing: border-box;
}
.title {
  margin-bottom: 30rpx;
  color: #f8fafc;
  font-size: 46rpx;
  font-weight: 800;
}
.panel {
  margin-bottom: 24rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  background: linear-gradient(145deg, rgba(30, 41, 59, 0.9), rgba(15, 23, 42, 0.94));
  border: 1rpx solid rgba(148, 163, 184, 0.14);
}
.row {
  color: #cbd5e1;
  font-size: 28rpx;
}
.split {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.12);
}
.key {
  color: #f8fafc;
  font-size: 30rpx;
  font-weight: 700;
}
.desc {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 23rpx;
}
.input,
.port {
  height: 78rpx;
  margin-top: 18rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  color: #e2e8f0;
  background: #0f172a;
  font-size: 26rpx;
}
.port {
  width: 160rpx;
  margin-top: 0;
  text-align: right;
}
.placeholder {
  color: #64748b;
}
button {
  height: 86rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.action {
  margin-top: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #3b82f6, #2563eb 64%, #22d3ee);
}
.danger {
  color: #fecaca;
  background: linear-gradient(135deg, rgba(239, 68, 68, 0.18), rgba(127, 29, 29, 0.16));
}
</style>

<script type="application/json">
{
  "navigationBarTitleText": "设置",
  "navigationBarBackgroundColor": "#111827",
  "navigationBarTextStyle": "white"
}
</script>

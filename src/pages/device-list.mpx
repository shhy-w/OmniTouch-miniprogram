<template>
  <view class="page">
    <view class="header">
      <view>
        <view class="eyebrow">多模态智能交互终端</view>
        <view class="title">我的设备</view>
      </view>
      <button class="add" bindtap="goProvisioning">＋</button>
    </view>
    <view class="dashboard">
      <view class="orb">⌬</view>
      <view class="stat"><text>{{onlineCount}}</text><text>在线</text></view>
      <view class="stat"><text>{{offlineCount}}</text><text>离线</text></view>
      <view class="stat"><text>{{queueCount}}</text><text>待补发</text></view>
    </view>
    <input class="search" placeholder="搜索设备名称或 ID" placeholder-class="placeholder" value="{{keyword}}" bindinput="onSearch" />
    <view class="list" wx:if="{{filteredDevices.length}}">
      <device-card wx:for="{{filteredDevices}}" wx:key="id" device="{{item}}" bindcontrol="goControl" binddetail="goDetail"></device-card>
    </view>
    <empty-state wx:else title="还没有设备" desc="扫码或热点配网后，设备会出现在这里"></empty-state>
    <view class="tabbar">
      <view class="tab active">设备</view>
      <view class="tab" bindtap="goSettings">设置</view>
    </view>
  </view>
</template>

<script lang="ts">
import { createPage } from '@mpxjs/core'
import { deviceStore } from '@/stores/device'
import type { Device } from '@/types/device'

createPage({
  data: {
    keyword: '',
    devices: [] as Device[],
    filteredDevices: [] as Device[],
    onlineCount: 0,
    offlineCount: 0,
    queueCount: 0
  },
  onShow() {
    this.refresh()
  },
  methods: {
    refresh() {
      const onlineCount = deviceStore.devices.filter((device) => device.status.online).length
      this.setData({
        devices: deviceStore.devices,
        filteredDevices: this.filter(deviceStore.devices, this.keyword),
        onlineCount,
        offlineCount: deviceStore.devices.length - onlineCount,
        queueCount: deviceStore.offlineQueue.length
      })
    },
    filter(devices: Device[], keyword: string) {
      const word = keyword.trim().toLowerCase()
      if (!word) return devices
      return devices.filter((device) => {
        return device.name.toLowerCase().includes(word) || device.id.toLowerCase().includes(word)
      })
    },
    onSearch(event: { detail: { value: string } }) {
      const keyword = event.detail.value
      this.setData({ keyword, filteredDevices: this.filter(this.devices, keyword) })
    },
    goControl(event: { detail: { id: string } }) {
      deviceStore.selectDevice(event.detail.id)
      wx.navigateTo({ url: `/pages/remote-control?id=${event.detail.id}` })
    },
    goDetail(event: { detail: { id: string } }) {
      wx.navigateTo({ url: `/pages/device-detail?id=${event.detail.id}` })
    },
    goProvisioning() {
      wx.navigateTo({ url: '/pages/provisioning' })
    },
    goSettings() {
      wx.navigateTo({ url: '/pages/settings' })
    }
  }
})
</script>

<style>

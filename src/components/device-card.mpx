<template>
  <view class="card">
    <view class="glow {{device.status.online ? 'onlineGlow' : ''}}"></view>
    <view class="top">
      <view class="identity">
        <view class="deviceIcon">◈</view>
        <view>
          <view class="name">{{device.name}}</view>
          <view class="meta">{{device.id}} · {{device.status.pcName}}</view>
        </view>
      </view>
      <status-pill label="{{device.status.online ? '在线' : '离线'}}" tone="{{device.status.online ? 'green' : 'red'}}"></status-pill>
    </view>
    <view class="grid">
      <view class="{{device.status.battery < 20 ? 'warning' : ''}}">▰ 电量 {{device.status.battery}}%</view>
      <view>≋ 信号 {{device.status.rssi}} dBm</view>
      <view>◎ 模式 {{modeText}}</view>
      <view>⌁ {{device.status.online ? '最后同步 刚刚' : '上次在线 ' + device.status.lastSeen}}</view>
    </view>
    <view class="actions">
      <button class="ghost" bindtap="detail">详情</button>
      <button class="primary" bindtap="control">{{device.status.online ? '进入控制' : '重新连接'}}</button>
    </view>
  </view>
</template>

<script>
import { createComponent } from '@mpxjs/core'

const modeMap = {
  voice: '语音',
  gesture: '手势',
  mqtt: '远程',
  offline: '离线'
}

createComponent({
  properties: {
    device: { type: Object, value: {} }
  },
  computed: {
    modeText() {
      return modeMap[this.device.status.mode] || this.device.status.mode
    }
  },
  methods: {
    control() {
      this.triggerEvent('control', { id: this.device.id })
    },
    detail() {
      this.triggerEvent('detail', { id: this.device.id })
    }
  }
})
</script>

<style>
.card {
  position: relative;
  padding: 28rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.22);
  border-radius: 16rpx;
  background:
    linear-gradient(145deg, rgba(30, 41, 59, 0.92), rgba(15, 23, 42, 0.96)),
    #172033;
  box-shadow: 0 24rpx 70rpx rgba(2, 6, 23, 0.34);
  overflow: hidden;
}
.glow {
  position: absolute;
  top: -60rpx;
  right: -48rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(100, 116, 139, 0.1);
}
.onlineGlow {
  background: radial-gradient(circle, rgba(34, 197, 94, 0.24), rgba(59, 130, 246, 0.08) 58%, transparent 70%);
}
.top,
.actions {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.identity {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.deviceIcon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  color: #bfdbfe;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.42), rgba(34, 211, 238, 0.16));
  text-align: center;
  line-height: 68rpx;
  box-shadow: 0 0 32rpx rgba(59, 130, 246, 0.22);
}
.name {
  color: #f8fafc;
  font-size: 34rpx;
  font-weight: 700;
}
.meta,
.grid {
  color: #94a3b8;
  font-size: 22rpx;
}
.grid {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 24rpx 0;
}
.warning {
  color: #fbbf24;
}
button {
  min-width: 180rpx;
  height: 72rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
}
.ghost {
  color: #bfdbfe;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.18), rgba(30, 64, 175, 0.16));
}
.primary {
  color: #fff;
  background: linear-gradient(135deg, #3b82f6, #2563eb 58%, #22d3ee);
  box-shadow: 0 12rpx 34rpx rgba(59, 130, 246, 0.28);
}
</style>

<script type="application/json">
{
  "component": true,
  "usingComponents": {
    "status-pill": "./status-pill"
  }
}
</script>
